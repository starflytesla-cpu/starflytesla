# SITE_ADDRESS 預設 :80（用 IP 以 http 開啟）；設成網域（例如 app.example.com）後，
# Caddy 會自動申請並續期 HTTPS 憑證，並把 http 轉址到 https。
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# 素材上傳（前端以 8 MB 分段續傳，這裡是單一請求的上限）
	request_body {
		max_size 2GB
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000 {
			# 上傳分段可能要傳一段時間，不要因為慢速網路被切斷
			transport http {
				read_timeout 10m
				write_timeout 10m
			}
		}
	}

	# 素材檔案：先由 API 檢查登入與租戶，通過才從唯讀的 media volume 回傳（支援影片拖曳的 Range 請求）
	# route 讓指令依寫的順序執行：先用原始路徑檢查權限，再去掉 /media 前綴找檔案
	handle /media/* {
		route {
			forward_auth api:8000 {
				uri /api/media/auth
			}
			uri strip_prefix /media
			root * /media
			header Cache-Control "private, max-age=86400"
			file_server
		}
	}

	# Vite 產出的檔名含內容雜湊，可以長期快取
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# 其他路徑都回傳 index.html（前端路由），且不快取，確保部署後立即拿到新版本
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# 容器健康檢查專用，不對外開放
:8081 {
	respond /healthz "ok" 200
}
