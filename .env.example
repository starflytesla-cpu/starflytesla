# 第一次執行 infra/scripts/deploy.sh 時，會複製成 .env 並把 change-me 自動換成隨機密碼。
# .env 只存在伺服器上，絕對不要提交到 git。

# 網站位址：先用 :80（用 IP 以 http 開啟）；有網域後改成網域，例如 app.example.com，
# 重新部署後 Caddy 會自動申請 HTTPS 憑證。
SITE_ADDRESS=:80

POSTGRES_USER=starfly
POSTGRES_PASSWORD=change-me
POSTGRES_DB=starfly

MINIO_ROOT_USER=starfly
MINIO_ROOT_PASSWORD=change-me

# 用於登入 token 與加密 AI 渠道的 API Key。產生後不要更換，否則已存的 API Key 要重新填寫。
SECRET_KEY=change-me

# 第一次啟動時用這組帳密建立管理員（之後在網頁上改密碼，這裡的值就不再使用）。
ADMIN_EMAIL=admin@starfly.local
ADMIN_PASSWORD=change-me

# AI 服務的 API Key 不放在這裡：登入後台 →「模型渠道」填寫，會加密存進資料庫。
